# Superuser (created by Postgres on init)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# Replication user — required on both primary and replica
REPLICATION_USER=replicator
REPLICATION_PASSWORD=replicator_password

# Application user — created on primary only (optional)
APP_USER=app
APP_PASSWORD=app_password

# Replica-only settings
# PRIMARY_HOST: hostname/IP of primary
#   single-host compose: postgres_primary (service name)
#   split-host:          real IP, e.g. 192.168.1.10
# REPLICA_SLOT: unique per replica (replica_slot_1, replica_slot_2, ...)
PRIMARY_HOST=postgres_primary
REPLICA_SLOT=replica_slot_1
