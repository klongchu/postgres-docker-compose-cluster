# Production environment template
# IMPORTANT: Do not commit this file with real passwords to version control.
# Copy to .env and fill in secure values before deployment.

# =====================
# PostgreSQL superuser
# =====================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_USE_SECURE_PASSWORD
POSTGRES_DB=postgres

# =====================
# Replication user
# =====================
REPLICATION_USER=replicator
REPLICATION_PASSWORD=CHANGE_ME_USE_SECURE_PASSWORD

# =====================
# Application user
# =====================
APP_USER=app
APP_PASSWORD=CHANGE_ME_USE_SECURE_PASSWORD

# =====================
# Replica-only settings
# =====================
# PRIMARY_HOST: IP address or hostname of primary server
#   Split-host: use real IP, e.g. 10.0.1.10
PRIMARY_HOST=10.0.1.10

# REPLICA_SLOT: must be unique per replica (replica_slot_1, replica_slot_2, ...)
REPLICA_SLOT=replica_slot_1

# REPLICA_NAME: used for synchronous_standby_names on primary (replica_1, replica_2, ...)
REPLICA_NAME=replica_1

# =====================
# pgAdmin (optional)
# =====================
PGADMIN_EMAIL=admin@yourcompany.com
PGADMIN_PASSWORD=CHANGE_ME_USE_SECURE_PASSWORD
